include requirements.txt
include README.md
include RELEASE_NOTES.md
include LICENSE
include NOTICE
prune docs/development
prune dev-log
prune dev-logs
prune roadmap
prune test-model-cache
prune test-results
prune docs_private
prune docs/handoffs
prune tests_private
# Host-specific deployment recipes stay in the repository, not the sdist.
prune deploy
global-exclude *Kopie*.py
global-exclude *.bak
global-exclude *.tmp
global-exclude *.log
global-exclude *.jsonl
